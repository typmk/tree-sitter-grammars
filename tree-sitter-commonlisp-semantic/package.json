{
  "name": "tree-sitter-commonlisp-semantic",
  "version": "0.1.0",
  "description": "Semantic Tree-sitter grammar for Common Lisp with defun, defclass, defmacro nodes",
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "parser",
    "commonlisp",
    "lisp",
    "tree-sitter"
  ],
  "files": [
    "grammar.js",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**"
  ],
  "dependencies": {
    "node-addon-api": "^7.1.0",
    "node-gyp-build": "^4.8.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.21.0"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.22.0"
  },
  "scripts": {
    "generate": "tree-sitter generate",
    "build-wasm": "tree-sitter build --wasm",
    "test": "tree-sitter test"
  },
  "tree-sitter": [
    {
      "scope": "source.commonlisp",
      "file-types": [
        "lisp",
        "lsp",
        "cl",
        "asd",
        "asdf"
      ]
    }
  ]
}
